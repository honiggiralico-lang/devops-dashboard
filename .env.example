# ==========================================
# DevOps Dashboard - Configurazione Ambiente
# ==========================================

# Configurazione PostgreSQL
POSTGRES_USER=devops_user
POSTGRES_PASSWORD=devops_password
POSTGRES_DB=devops_db

# Stringa di connessione Database (usata dal Backend)
DATABASE_URL=postgresql://devops_user:devops_password@db:5432/devops_db

# Porte esposte (Compose)
FRONTEND_PORT=3000
BACKEND_PORT=8000
DATABASE_PORT=5432
